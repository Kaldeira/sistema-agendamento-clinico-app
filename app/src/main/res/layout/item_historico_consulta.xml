<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvConsultaId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Consulta"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

            <TextView
                android:id="@+id/tvStatusConsulta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRMADA"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/chip_background"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDataHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-05-01 às 09:00"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvNomes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paciente → Médico"
            android:textSize="12sp"
            android:textColor="#555555"
            android:layout_marginTop="2dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginVertical="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMetodo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PIX"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2196F3"/>

            <TextView
                android:id="@+id/tvValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 150,00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusPagamento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅ Aprovado"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#4CAF50"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
