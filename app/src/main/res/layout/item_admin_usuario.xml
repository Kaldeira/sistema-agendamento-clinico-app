<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Iniciais -->
        <TextView
            android:id="@+id/tvIniciais"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="U"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/circle_primary" />

        <!-- Foto -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFotoUser"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:src="@drawable/bg_circle_image"
            app:shapeAppearanceOverlay="@style/CircleImage"/>

        <!-- Info block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvNomeUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />

            <TextView
                android:id="@+id/tvInfoUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tipo — email"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Action buttons -->
        <Button
            android:id="@+id/btnEditar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Editar"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnDeletar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Deletar"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:backgroundTint="#FFF3F3"
            android:textColor="#F44336" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
