<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Left: ID + date + names -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvConsultaId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consulta #1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />

            <TextView
                android:id="@+id/tvConsultaData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-05-01 às 09:00"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvConsultaNomes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paciente → Médico"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Right: status badge -->
        <TextView
            android:id="@+id/tvConsultaStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENDENTE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFC107"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/chip_background" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
