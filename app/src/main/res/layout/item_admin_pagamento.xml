<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Left: consulta, method, date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPagConsulta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consulta #1"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />

            <TextView
                android:id="@+id/tvPagMetodo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PIX"
                android:textSize="12sp"
                android:textColor="#2196F3"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvPagDataHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-05-01 09:00:00"
                android:textSize="11sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Right: valor + status -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvPagValor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 150,00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E" />

            <TextView
                android:id="@+id/tvPagStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Aprovado"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_marginTop="4dp"
                android:gravity="end" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
