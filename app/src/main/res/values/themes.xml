<resources>

    <style name="Theme.ClinicaApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="InputDropdownStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>

        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>

        <item name="android:textColorHint">#777777</item>
    </style>

    <style name="ModernTextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <!-- Formato -->
        <item name="boxBackgroundMode">outline</item>

        <!-- Cantos arredondados -->
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>

        <!-- Cores -->
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="android:textColorHint">#9E9E9E</item>
        <item name="hintTextColor">#9E9E9E</item>

        <!-- Fundo -->
        <item name="boxBackgroundColor">#FAFAFA</item>

        <!-- Borda -->
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

    </style>

    <style name="ModernEditText">
        <item name="android:textColor">#1A1A2E</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="ModernButton" parent="Widget.MaterialComponents.Button">

        <!-- Formato -->
        <item name="cornerRadius">14dp</item>

        <!-- Cor -->
        <item name="backgroundTint">@color/colorPrimary</item>

        <!-- Texto -->
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>

        <!-- Espaçamento -->
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>

        <!-- Remove sombra pesada -->
        <item name="elevation">2dp</item>

        <!-- Ripple moderno -->
        <item name="rippleColor">#33FFFFFF</item>

    </style>

</resources>
